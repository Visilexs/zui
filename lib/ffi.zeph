// ---- memory and strings ----

// off-heap memory (never freed): buffers C keeps or writes into
fn nativeAlloc(n: int) -> int { return win("VirtualAlloc", 0, n, 12288, 4) }

// a NUL-terminated copy of `text` in a reusable off-heap slot; valid until
// the same slot is used again
var cstrSlots: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
var cstrCapacities: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
fn cstrIn(slot: int, text: str) -> int {
    let n = text.len()
    if cstrCapacities[slot] < n + 1 {
        var capacity = 256
        while capacity < n + 1 { capacity = capacity * 2 }
        cstrSlots[slot] = nativeAlloc(capacity)
        cstrCapacities[slot] = capacity
    }
    let p = cstrSlots[slot]
    if n > 0 { memcpy(p, strData(text), n) }
    store8(p + n, 0)
    return p
}
fn cstr(text: str) -> int { return cstrIn(0, text) }

// a permanent NUL-terminated copy
fn cstrKeep(text: str) -> int {
    let p = nativeAlloc(text.len() + 1)
    if text.len() > 0 { memcpy(p, strData(text), text.len()) }
    store8(p + text.len(), 0)
    return p
}

// address of a str's bytes (layout: [0] length, [8] bytes)
fn strData(text: str) -> int { return addr(text) + 8 }

// n bytes at p as a new str
fn strFrom(p: int, n: int) -> str {
    if n <= 0 { return "" }
    if n == 1 { return chr(load8(p)) }
    let text = " ".repeat(n)       // a fresh, unshared string; filled in place
    memcpy(strData(text), p, n)
    return text
}

fn strFromC(p: int) -> str {
    if p == 0 { return "" }
    return strFrom(p, strlen(p))
}

fn sdlError() -> str { return strFromC(SDL_GetError()) }

fn envVar(name: str) -> str { return strFromC(getenv(cstr(name))) }
