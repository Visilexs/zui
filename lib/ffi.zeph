// Native bindings: SDL3 (window, input, GPU renderer), FreeType + fontconfig
// (text), and a little libc (process spawning). All of it through `extern fn`,
// which on --linux loads the library with dlopen on first use.
//
// Struct offsets were taken from the installed headers (SDL 3.4, FreeType 2.14)
// with offsetof; they are the x86-64 System V layouts.
import "std/bytes.zeph"

extern fn SDL_Init(flags: int) -> bool from "libSDL3.so.0"
extern fn SDL_Quit() from "libSDL3.so.0"
extern fn SDL_GetError() -> int from "libSDL3.so.0"
