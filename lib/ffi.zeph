extern fn SDL_CreateTexture(renderer: int, format: int, access: int, w: int, h: int) -> int from "libSDL3.so.0"
extern fn SDL_UpdateTexture(texture: int, rect: int, pixels: int, pitch: int) -> bool from "libSDL3.so.0"
